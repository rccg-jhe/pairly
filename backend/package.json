{
  "name": "pairly-backend",
  "version": "1.0.0",
  "description": "Pairly backend: Express API",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env app.js",
    "dev": "node --env-file-if-exists=.env --watch app.js",
    "try-models": "node --env-file-if-exists=.env scripts/try-models.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "try-realtime": "node --env-file-if-exists=.env scripts/try-realtime.js",
    "smoke": "node --env-file-if-exists=.env scripts/smoke-test.js",
    "set-password": "node --env-file-if-exists=.env scripts/set-password.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongoose": "^9.13.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
