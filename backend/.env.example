# Copy this file to .env and fill in real values. Never commit .env!
PORT=3000
# MongoDB Atlas connection string, with the database name after the host.
# Must be Atlas (or a replica set): shuffles use transactions.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pairly

# The presenter login (there is no sign-up). Don't type these by hand:
# run `npm run set-password`, which fills them in for you.
PRESENTER_USERNAME=
PRESENTER_PASSWORD_HASH=
